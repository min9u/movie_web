# TMDB: v3 API Key 또는 v4 Read Access Token(eyJ...) 모두 사용 가능
VITE_TMDB_API_KEY=your_tmdb_api_key_or_token
# Youtube Data API v3 Key
VITE_YOUTUBE_API_KEY=your_youtube_api_key
# 영화 데이터 출처: tmdb (TMDB 직접 호출) | django (F05 - PJT02 Django 서버 경유)
VITE_MOVIE_API_SOURCE=tmdb
VITE_DJANGO_API_URL=http://127.0.0.1:8000/api/v1
